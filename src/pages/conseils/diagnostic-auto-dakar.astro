);
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappText}`;

const title = 'Diagnostic auto à Dakar : comprendre avant de réparer | Atelier Faye Auto';
const description =
  'Voyant allumé, bruit, fuite ? Avant de changer une pièce, faites un vrai diagnostic auto à Dakar. Envoyez une photo ou une vidéo sur WhatsApp à Atelier Faye Auto.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Diagnostic auto à Dakar : pourquoi il ne faut pas réparer sans comprendre la panne',
  description,
  inLanguage: 'fr',
  author: { '@type': 'Organization', name: 'Atelier Faye Auto' },
  publisher: {
    '@type': 'AutoRepair',
    name: 'Atelier Faye Auto',
    address: { '@type': 'PostalAddress', addressLocality: 'Dakar', addressCountry: 'SN' },
    areaServed: 'Dakar',
    telephone: '+221774797157',
  },
};
