@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap");
@import "tailwindcss";

:root {
  --paper: #f1eee6;
  --paper-2: #e9e5dc;
  --soft: #fffdf8;
  --text: #1c2a30;
  --petrol: #14424f;
  --petrol-dark: #0b3440;
  --mint: #2fbf8f;
  --mint-soft: #dff5ec;
  --steel: #8a949b;
  --line: rgba(138, 148, 155, 0.32);
  --orange: #f2a23a;
  --red: #d93b3b;
  --shadow: 0 22px 60px rgba(20, 66, 79, 0.11);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background:
    radial-gradient(circle at 8% 8%, rgba(20, 66, 79, 0.08), transparent 28rem),
    radial-gradient(circle at 92% 18%, rgba(47, 191, 143, 0.08), transparent 26rem),
    var(--paper);
  color: var(--text);
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  display: block;
  max-width: 100%;
}

svg {
  width: 100%;
  height: 100%;
  fill: none;
  stroke: currentColor;
  stroke-width: 3.2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.accent,
.accent-stroke {
  color: var(--mint);
  stroke: var(--mint);
}

h1,
h2,
h3 {
  margin: 0;
  font-family: "Space Grotesk", Inter, system-ui, sans-serif;
  letter-spacing: -0.055em;
}

p {
  margin-top: 0;
}

/* HEADER */

.app-header {
  position: sticky;
  top: 0;
  z-index: 50;
  width: min(1240px, calc(100% - 40px));
  height: 86px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
  padding: 14px 22px;
  background: rgba(255, 253, 248, 0.92);
  border: 1px solid rgba(138, 148, 155, 0.26);
  border-top: 0;
  border-radius: 0 0 22px 22px;
  backdrop-filter: blur(10px);
}

.logo-link img {
  width: 168px;
  max-height: 56px;
  object-fit: contain;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 28px;
  color: rgba(28, 42, 48, 0.72);
  font-size: 14px;
  font-weight: 800;
}

.main-nav a:hover {
  color: var(--petrol);
}

.nav-cta {
  display: inline-flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  padding: 0 19px;
  border-radius: 13px;
  background: var(--petrol);
  color: white;
  font-weight: 900;
  box-shadow: 0 14px 30px rgba(20, 66, 79, 0.14);
}

.hamburger {
  display: none;
}

/* LAYOUT DESKTOP */

.page-shell {
  width: min(1240px, calc(100% - 40px));
  margin: 0 auto;
  padding: 28px 0 110px;
}

/* HERO */

.hero-app {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  min-height: 570px;
  overflow: hidden;
  border-radius: 26px;
  background: var(--soft);
  border: 1px solid rgba(138, 148, 155, 0.28);
  box-shadow: var(--shadow);
}

.hero-text {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 58px 54px;
}

.hero-text h1 {
  max-width: 560px;
  color: var(--petrol);
  font-size: clamp(58px, 5.8vw, 96px);
  line-height: 0.91;
}

.hero-text p {
  max-width: 510px;
  margin: 22px 0 22px;
  color: rgba(28, 42, 48, 0.78);
  font-size: 19px;
  line-height: 1.48;
}

.whatsapp-button {
  display: inline-flex;
  width: fit-content;
  min-width: 294px;
  min-height: 56px;
  align-items: center;
  justify-content: center;
  padding: 15px 22px;
  border-radius: 14px;
  background: var(--mint);
  color: white;
  font-weight: 950;
  box-shadow: 0 16px 32px rgba(47, 191, 143, 0.25);
}

.hero-visual {
  position: relative;
  min-height: 570px;
  overflow: hidden;
  background: #ddd7cc;
}

.hero-visual img {
  width: 100%;
  height: 100%;
  min-height: 570px;
  object-fit: cover;
}

.hero-visual::after {
  content: "Diagnostic électronique";
  position: absolute;
  left: 20px;
  bottom: 20px;
  padding: 10px 14px;
  border-radius: 999px;
  background: rgba(11, 52, 64, 0.86);
  color: white;
  font-size: 13px;
  font-weight: 900;
}

.hero-check {
  position: absolute;
  right: 22px;
  top: 22px;
  display: grid;
  place-items: center;
  width: 58px;
  height: 58px;
  border-radius: 999px;
  background: var(--mint);
  color: white;
  font-size: 28px;
  font-weight: 950;
  box-shadow: 0 18px 36px rgba(47, 191, 143, 0.28);
}

/* SECTIONS */

.section-block {
  margin-top: 40px;
}

.section-title {
  margin-bottom: 18px;
}

.section-title h2 {
  color: var(--petrol);
  font-size: clamp(32px, 3.1vw, 52px);
  line-height: 0.98;
}

.section-title p {
  margin: 7px 0 0;
  color: rgba(28, 42, 48, 0.68);
  font-size: 17px;
  line-height: 1.45;
}

/* PROBLEMES */

.problem-grid-large {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.problem-tile {
  position: relative;
  display: grid;
  place-items: center;
  min-height: 196px;
  padding: 24px 18px;
  text-align: center;
  background: var(--soft);
  border: 1px solid rgba(138, 148, 155, 0.26);
  border-radius: 20px;
  transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
}

.problem-tile:hover,
.problem-tile:focus-visible {
  transform: translateY(-3px);
  border-color: rgba(20, 66, 79, 0.28);
  box-shadow: 0 18px 38px rgba(20, 66, 79, 0.09);
  outline: none;
}

.tile-icon {
  display: block;
  width: 68px;
  height: 68px;
  color: var(--petrol);
}

.problem-tile strong {
  margin-top: 12px;
  color: var(--petrol);
  font-size: 17px;
  line-height: 1.08;
}

.problem-tile small {
  display: block;
  max-width: 220px;
  margin-top: 7px;
  color: rgba(28, 42, 48, 0.62);
  font-size: 13px;
  line-height: 1.35;
}

.mini-status {
  position: absolute;
  top: 16px;
  left: 16px;
  width: 12px;
  height: 12px;
  border-radius: 999px;
  background: var(--steel);
}

.ok {
  background: var(--mint);
}

.watch {
  background: var(--orange);
}

.urgent {
  background: var(--red);
}

.see-all {
  display: flex;
  min-height: 46px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin: 18px auto 0;
  color: var(--petrol);
  font-weight: 900;
}

/* PHOTO / VIDEO */

.send-photo-card {
  display: grid;
  grid-template-columns: 82px 132px 1fr 54px;
  align-items: center;
  gap: 18px;
  margin-top: 34px;
  padding: 22px;
  border-radius: 22px;
  background: var(--mint-soft);
  border: 1px solid rgba(47, 191, 143, 0.38);
  box-shadow: 0 16px 38px rgba(47, 191, 143, 0.11);
}

.photo-icon {
  display: grid;
  place-items: center;
  width: 82px;
  height: 82px;
  padding: 20px;
  border-radius: 999px;
  background: var(--petrol);
  color: var(--mint);
}

.send-photo-card > img {
  width: 132px;
  height: 92px;
  border-radius: 16px;
  object-fit: cover;
}

.send-photo-card h2 {
  color: var(--petrol);
  font-size: clamp(26px, 2.7vw, 42px);
  line-height: 1;
}

.send-photo-card p {
  max-width: 650px;
  margin: 7px 0 0;
  color: rgba(28, 42, 48, 0.72);
  font-size: 16px;
  line-height: 1.45;
}

.round-arrow {
  display: grid;
  place-items: center;
  width: 54px;
  height: 54px;
  border-radius: 999px;
  background: var(--mint);
  color: white;
  font-size: 28px;
  font-weight: 950;
}

/* TRUST */

.trust-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 22px;
  overflow: hidden;
  border-radius: 20px;
  background: var(--petrol);
  color: white;
}

.trust-strip article {
  min-height: 122px;
  display: grid;
  place-items: center;
  padding: 20px 12px;
  text-align: center;
  border-right: 1px solid rgba(244, 241, 234, 0.18);
}

.trust-strip article:last-child {
  border-right: 0;
}

.trust-strip span {
  width: 42px;
  height: 42px;
  color: var(--mint);
}

.trust-strip strong {
  display: block;
  margin-top: 9px;
  font-size: 16px;
}

.trust-strip small {
  color: rgba(255, 255, 255, 0.72);
}

/* CARNET ENTRETIEN */

.maintenance-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
}

.maintenance-item {
  position: relative;
  min-height: 136px;
  display: grid;
  place-items: center;
  gap: 8px;
  padding: 18px 12px;
  border-radius: 20px;
  background: var(--soft);
  border: 1px solid rgba(138, 148, 155, 0.26);
  text-align: center;
}

.maintenance-icon {
  width: 52px;
  height: 52px;
  color: var(--petrol);
}

.maintenance-item strong {
  color: var(--petrol);
  font-size: 15px;
}

.small-badge {
  position: absolute;
  right: 12px;
  bottom: 12px;
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border-radius: 999px;
  color: white;
  font-weight: 950;
}

.outline-button {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  min-height: 54px;
  margin-top: 16px;
  border-radius: 16px;
  border: 1px solid rgba(47, 191, 143, 0.65);
  background: rgba(255, 253, 248, 0.58);
  color: var(--petrol);
  font-weight: 900;
}

.outline-button span {
  width: 26px;
  height: 26px;
}

/* AVANT PENDANT APRES */

.follow-card,
.mechanic-card,
.final-whatsapp {
  margin-top: 34px;
  padding: 24px;
  border-radius: 22px;
  background: var(--soft);
  border: 1px solid rgba(138, 148, 155, 0.26);
}

.follow-progress {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.follow-progress article {
  padding: 20px;
  border-radius: 18px;
  background: var(--petrol);
  color: white;
}

.follow-progress span {
  display: inline-grid;
  place-items: center;
  width: 44px;
  height: 36px;
  margin-bottom: 10px;
  border-radius: 11px;
  background: rgba(47, 191, 143, 0.18);
  color: var(--mint);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-weight: 950;
}

.follow-progress p {
  margin: 7px 0 0;
  color: rgba(255, 255, 255, 0.74);
  line-height: 1.45;
}

/* FAMILLE */

.mechanic-card {
  display: grid;
  grid-template-columns: 0.95fr 1.05fr;
  align-items: center;
  gap: 26px;
}

.mechanic-card img {
  width: 100%;
  aspect-ratio: 4 / 3;
  border-radius: 18px;
  object-fit: cover;
}

.label {
  margin: 0 0 10px;
  color: var(--mint);
  font-size: 13px;
  font-weight: 950;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.mechanic-card h2 {
  color: var(--petrol);
  font-size: clamp(34px, 3.5vw, 56px);
  line-height: 1;
}

.mechanic-card p {
  color: rgba(28, 42, 48, 0.74);
  line-height: 1.55;
}

/* SERVICES */

.technical-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  overflow: hidden;
  border: 1px solid rgba(138, 148, 155, 0.32);
  border-radius: 20px;
  background: var(--soft);
}

.technical-list article {
  position: relative;
  min-height: 104px;
  padding: 20px 20px 20px 42px;
  border-bottom: 1px solid rgba(138, 148, 155, 0.23);
}

.technical-list article:nth-child(odd) {
  border-right: 1px solid rgba(138, 148, 155, 0.23);
}

.technical-list article:nth-last-child(-n + 2) {
  border-bottom: 0;
}

.technical-list .mini-status {
  position: absolute;
  left: 20px;
  top: 25px;
}

.technical-list strong {
  display: block;
  color: var(--petrol);
  font-size: 15px;
  line-height: 1.25;
  text-transform: uppercase;
}

.technical-list p {
  margin: 6px 0 0;
  color: rgba(28, 42, 48, 0.7);
  line-height: 1.45;
}

/* CONSEILS */

.inline-title {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 18px;
}

.inline-title a {
  color: var(--petrol);
  font-weight: 900;
  white-space: nowrap;
}

.tips-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.tip-card {
  display: grid;
  overflow: hidden;
  border-radius: 20px;
  background: var(--soft);
  border: 1px solid rgba(138, 148, 155, 0.26);
}

.tip-thumb {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  background: #e6e1d8;
}

.tip-card-body {
  padding: 18px;
}

.tip-card h3 {
  color: var(--petrol);
  font-size: 22px;
  line-height: 1.05;
}

.tip-card p {
  margin: 9px 0 12px;
  color: rgba(28, 42, 48, 0.7);
  line-height: 1.45;
}

.tip-card small {
  color: var(--petrol);
  font-weight: 900;
}

/* CTA FINAL */

.final-whatsapp {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 22px;
  background: var(--petrol);
  color: white;
}

.final-whatsapp h2 {
  font-size: clamp(34px, 3.2vw, 54px);
  line-height: 1;
}

.final-whatsapp p {
  margin: 8px 0 0;
  color: rgba(255, 255, 255, 0.74);
}

.final-whatsapp a {
  display: flex;
  min-width: 300px;
  min-height: 56px;
  align-items: center;
  justify-content: center;
  border-radius: 15px;
  background: var(--mint);
  color: white;
  font-weight: 950;
}

/* BOTTOM NAV SUPPRIMEE */

.bottom-nav {
  display: none !important;
}

/* CTA FLOTTANT */

.floating-photo {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 60;
  display: flex;
  min-height: 56px;
  align-items: center;
  justify-content: center;
  padding: 0 24px;
  border-radius: 15px;
  background: var(--mint);
  color: white;
  font-weight: 950;
  box-shadow: 0 18px 38px rgba(20, 66, 79, 0.23);
}

/* TABLETTE */

@media (max-width: 900px) {
  .app-header,
  .page-shell {
    width: min(100% - 28px, 760px);
  }

  .main-nav,
  .nav-cta {
    display: none;
  }

  .hamburger {
    display: grid;
    gap: 5px;
    width: 44px;
    height: 44px;
    place-content: center;
    border: 1px solid rgba(138, 148, 155, 0.5);
    border-radius: 12px;
    background: transparent;
  }

  .hamburger span {
    display: block;
    width: 21px;
    height: 2px;
    background: var(--petrol);
  }

  .hero-app {
    grid-template-columns: 1fr;
    min-height: 0;
  }

  .hero-text {
    padding: 34px 28px 26px;
  }

  .hero-text h1 {
    font-size: clamp(48px, 10vw, 74px);
  }

  .hero-visual,
  .hero-visual img {
    min-height: 360px;
  }

  .problem-grid-large {
    grid-template-columns: repeat(2, 1fr);
  }

  .send-photo-card {
    grid-template-columns: 76px 1fr 52px;
  }

  .send-photo-card > img {
    display: none;
  }

  .maintenance-row {
    grid-template-columns: repeat(5, minmax(120px, 1fr));
    overflow-x: auto;
    padding-bottom: 8px;
  }

  .mechanic-card,
  .final-whatsapp {
    grid-template-columns: 1fr;
  }

  .technical-list {
    grid-template-columns: 1fr;
  }

  .technical-list article,
  .technical-list article:nth-child(odd),
  .technical-list article:nth-last-child(-n + 2) {
    border-right: 0;
    border-bottom: 1px solid rgba(138, 148, 155, 0.23);
  }

  .technical-list article:last-child {
    border-bottom: 0;
  }

  .tips-grid {
    grid-template-columns: 1fr;
  }

  .final-whatsapp a {
    width: 100%;
    min-width: 0;
  }

  .floating-photo {
    left: 18px;
    right: 18px;
    bottom: 18px;
  }
}

/* MOBILE */

@media (max-width: 520px) {
  .app-header {
    width: 100%;
    height: 72px;
    border-left: 0;
    border-right: 0;
    border-radius: 0;
    padding: 11px 15px;
  }

  .logo-link img {
    width: 146px;
  }

  .page-shell {
    width: 100%;
    padding: 14px 14px 94px;
  }

  .hero-app {
    border-radius: 18px;
  }

  .hero-text {
    padding: 26px 20px 20px;
  }

  .hero-text h1 {
    max-width: 330px;
    font-size: 43px;
    line-height: 0.96;
  }

  .hero-text p {
    margin: 15px 0 18px;
    font-size: 16px;
  }

  .whatsapp-button {
    width: 100%;
    min-width: 0;
    min-height: 54px;
    font-size: 14px;
  }

  .hero-visual,
  .hero-visual img {
    min-height: 260px;
  }

  .hero-visual {
    border-radius: 0 0 18px 18px;
  }

  .hero-visual::after {
    left: 14px;
    bottom: 14px;
    font-size: 12px;
  }

  .hero-check {
    right: 14px;
    top: 14px;
    width: 50px;
    height: 50px;
  }

  .section-block {
    margin-top: 26px;
  }

  .section-title h2 {
    font-size: 31px;
  }

  .section-title p {
    font-size: 15px;
  }

  .problem-grid-large {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .problem-tile {
    min-height: 148px;
    padding: 16px 10px;
    border-radius: 16px;
  }

  .tile-icon {
    width: 55px;
    height: 55px;
  }

  .problem-tile strong {
    font-size: 14px;
  }

  .problem-tile small {
    display: none;
  }

  .send-photo-card {
    grid-template-columns: 60px 1fr 42px;
    gap: 12px;
    padding: 16px;
    border-radius: 18px;
  }

  .photo-icon {
    width: 60px;
    height: 60px;
    padding: 15px;
  }

  .send-photo-card h2 {
    font-size: 24px;
  }

  .send-photo-card p {
    font-size: 14px;
  }

  .round-arrow {
    width: 42px;
    height: 42px;
    font-size: 23px;
  }

  .trust-strip {
    border-radius: 16px;
  }

  .trust-strip article {
    min-height: 104px;
    padding: 14px 8px;
  }

  .trust-strip span {
    width: 34px;
    height: 34px;
  }

  .trust-strip strong {
    font-size: 12px;
  }

  .trust-strip small {
    font-size: 11px;
  }

  .maintenance-row {
    grid-template-columns: repeat(5, 116px);
  }

  .maintenance-item {
    min-height: 118px;
    border-radius: 16px;
  }

  .follow-card,
  .mechanic-card,
  .final-whatsapp {
    margin-top: 24px;
    padding: 18px;
    border-radius: 18px;
  }

  .follow-progress {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .follow-progress article {
    border-radius: 16px;
  }

  .mechanic-card h2 {
    font-size: 30px;
  }

  .technical-list {
    border-radius: 16px;
  }

  .technical-list article {
    min-height: 92px;
    padding: 16px 16px 16px 36px;
  }

  .technical-list .mini-status {
    left: 16px;
    top: 21px;
  }

  .technical-list strong {
    font-size: 13px;
  }

  .technical-list p {
    font-size: 14px;
  }

  .tip-card {
    border-radius: 16px;
  }

  .tip-card-body {
    padding: 16px;
  }

  .final-whatsapp h2 {
    font-size: 30px;
  }

  .floating-photo {
    left: 14px;
    right: 14px;
    bottom: 14px;
    min-height: 54px;
    border-radius: 14px;
  }
}

/* === DESKTOP HERO LARGE AVEC IMAGE EN OVERLAY === */
/* Desktop = vrai site large. Mobile = expérience app conservée. */

@media (min-width: 901px) {
  .app-header {
    width: min(1380px, calc(100% - 48px));
  }

  .page-shell {
    width: min(1180px, calc(100% - 48px));
  }

